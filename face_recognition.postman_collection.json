{
	"info": {
		"_postman_id": "c0a52df4-7221-4f11-9e7f-b883c5a7b1ee",
		"name": "Face Recognition Attendance API",
		"description": "API collection for registering, training, recognizing faces, and managing attendance data.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Stats",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/stats",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"stats"
					]
				},
				"description": "Get overall system stats, including total registered people, total training images, and last training timestamp."
			},
			"response": []
		},
		{
			"name": "Register Face",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"John Doe\",\n    \"image\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/... (base64 representation of face image)\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"register"
					]
				},
				"description": "Register a new face to the system by passing a name and base64-encoded image data."
			},
			"response": []
		},
		{
			"name": "Train Model",
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": ""
				},
				"url": {
					"raw": "{{base_url}}/api/train",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"train"
					]
				},
				"description": "Train the face recognition model with the registered dataset."
			},
			"response": []
		},
		{
			"name": "Recognize Face & Log Attendance",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"image\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/... (base64 representation of face image to match)\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/recognize",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"recognize"
					]
				},
				"description": "Recognize a face from a base64-encoded image and automatically log attendance if a match is found under the confidence threshold."
			},
			"response": []
		},
		{
			"name": "Get Attendance Logs",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/logs?date=2026-06-15",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"logs"
					],
					"query": [
						{
							"key": "date",
							"value": "2026-06-15",
							"description": "Date format YYYY-MM-DD"
						}
					]
				},
				"description": "Get all attendance logs recorded for a specific date."
			},
			"response": []
		},
		{
			"name": "Clear Dataset & Model",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": null\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/clear",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"clear"
					]
				},
				"description": "Clear all dynamic datasets and model files. Set 'name' value to a string to delete a specific person's dataset folder instead."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:5000",
			"type": "string"
		}
	]
}
